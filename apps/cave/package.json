{
  "name": "the-cave",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "budget": "node scripts/budget.mjs",
    "bake": "node scripts/bake.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "playwright test",
    "test:gestures": "node --experimental-strip-types --no-warnings tests/gestures/check.mts"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.169.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
